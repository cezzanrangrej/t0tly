# Copy to .env and fill in secrets before running docker compose
# Generate Feistel keys: python -c "import secrets; print(secrets.token_hex(8))"

HOST=0.0.0.0
PORT=8000
WORKERS=1
REDIRECT_CODE=302
BASE_URL=http://localhost

POSTGRES_DSN=postgresql://urlshort:CHANGE_ME@postgres:5432/urlshort
DB_MIN_POOL=2
DB_MAX_POOL=10

REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_TIMEOUT=0.5
CACHE_TTL_SECONDS=86400
LOCAL_CACHE_TTL=60
LOCAL_CACHE_MAX=10000

FEISTEL_KEY1=CHANGE_ME_hex8bytes
FEISTEL_KEY2=CHANGE_ME_hex8bytes
FEISTEL_KEY3=CHANGE_ME_hex8bytes
FEISTEL_KEY4=CHANGE_ME_hex8bytes
ID_BLOCK_SIZE=100000

RATE_LIMIT_CREATES=10
RATE_LIMIT_WINDOW=60

ANALYTICS_QUEUE_SIZE=10000
ANALYTICS_BATCH_SIZE=200
ANALYTICS_FLUSH_INTERVAL=2.0

NEGATIVE_CACHE_TTL=30
NEGATIVE_CACHE_MAX=5000
