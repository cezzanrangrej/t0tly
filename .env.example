# ==============================================================================
# URL Shortener — Environment Configuration (.env)
# Copy this file to .env before starting the stack:
#   cp .env.example .env
# ==============================================================================

# Server
HOST=0.0.0.0
PORT=8000
WORKERS=1
REDIRECT_CODE=302
BASE_URL=http://localhost

# Database (PostgreSQL 16)
POSTGRES_DSN=postgresql://urlshort:urlshort@postgres:5432/urlshort
DB_MIN_POOL=2
DB_MAX_POOL=10

# Cache (Redis 7.4)
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=20
REDIS_TIMEOUT=0.5
CACHE_TTL_SECONDS=86400
LOCAL_CACHE_TTL=180
LOCAL_CACHE_MAX=50000

# ID Generation & Feistel Cipher
# CRITICAL SECURITY REQUIREMENT:
# These 4 keys must remain fixed across all worker processes, containers, and restarts
# to ensure deterministic bijection of IDs to short codes.
# In production, generate 8 random hex bytes (16 hex chars) per key:
#   python -c "import secrets; print(secrets.token_hex(8))"
# NEVER commit production keys to version control.
FEISTEL_KEY1=deadbeef01234567
FEISTEL_KEY2=cafebabe89abcdef
FEISTEL_KEY3=0011223344556677
FEISTEL_KEY4=8899aabbccddeeff
ID_BLOCK_SIZE=100000

# Rate Limiting (POST /shorten)
RATE_LIMIT_CREATES=10
RATE_LIMIT_WINDOW=60

# Asynchronous Analytics
ANALYTICS_ENABLED=true
ANALYTICS_BUILD=new
ANALYTICS_QUEUE_SIZE=50000
ANALYTICS_BATCH_SIZE=1000
ANALYTICS_FLUSH_INTERVAL=1.0

# Negative Cache
NEGATIVE_CACHE_TTL=30
NEGATIVE_CACHE_MAX=5000

# Optional Benchmark Endpoint (/bench)
ENABLE_BENCH_ENDPOINT=false
